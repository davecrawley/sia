  "rules": {
    "independent_unit": "paired enabled/disabled trial",
    "familywise_confidence": 0.95,
    "multiplicity": "Bonferroni paired Student-t intervals across all required matrix rows",
    "equivalence_rule": "complete adjusted interval strictly inside both margin limits",
    "overall_rule": "pass only when every required row passes and every global gate passes",
    "pilot_pairs_per_workload": 12,
    "pilot_in_confirmatory_analysis": false,
    "minimum_confirmatory_pairs": 30,
    "maximum_confirmatory_pairs": 200,
    "maximum_attempts_multiplier": 2,
    "planning_power": 0.90,
    "precision_target": "adjusted interval half-width <= one half of the equivalence margin",
    "optional_stopping": "forbidden"
  },
  "observer_arms": {
    "disabled": "same SIA binary and configuration with observation collection, buffering, export, and teardown disabled",
    "enabled": "same SIA binary and configuration with the observation mechanism under evaluation enabled, including drain, export, and teardown"
  },
  "workloads": [
    {
      "id": "cpu_fixed",
      "kind": "synthetic_control",
      "driver": "sysbench",
      "arguments": ["cpu", "--threads=1", "--cpu-max-prime=20000", "--time=180", "--rand-seed=104729", "run"],
      "seed": 104729,
      "concurrency": 1,
      "warmup_seconds": 60,
      "measurement_seconds": 180,
      "input_identity": "prime_limit=20000",
      "required_endpoints": ["target_throughput", "sia_cpu_rate", "sia_rss_mean", "sia_io_read_rate", "sia_io_write_rate", "sample_loss_rate", "collector_lateness_p99"]
    },
    {
      "id": "io_fixed",
      "kind": "synthetic_control",
      "driver": "fio",
      "arguments": ["--name=sia-seq", "--rw=readwrite", "--rwmixread=50", "--bs=1M", "--size=8G", "--ioengine=sync", "--direct=1", "--numjobs=1", "--runtime=180", "--time_based", "--group_reporting", "--randseed=104729"],
      "seed": 104729,
      "concurrency": 1,
      "warmup_seconds": 60,
      "measurement_seconds": 180,
      "input_identity": "isolated benchmark-owned 8 GiB file restored before each arm",
      "required_endpoints": ["target_throughput", "sia_cpu_rate", "sia_rss_mean", "sia_io_read_rate", "sia_io_write_rate", "sample_loss_rate", "collector_lateness_p99"]
    },
    {
      "id": "gpu_offscreen_fixed",
      "kind": "synthetic_control",
      "driver": "glmark2",
      "arguments": ["--off-screen", "--size", "1920x1080", "--benchmark", "build:duration=30,texture:duration=30,shading:duration=30,bump:duration=30,terrain:duration=30,refract:duration=30"],
      "seed": 104729,
      "concurrency": 1,
      "warmup_seconds": 60,
      "measurement_seconds": 180,
      "input_identity": "fixed ordered glmark2 scene list at 1920x1080",
      "required_endpoints": ["target_throughput", "sia_cpu_rate", "sia_rss_mean", "sia_io_read_rate", "sia_io_write_rate", "target_gpu_clock_mean", "target_gpu_power_mean", "target_gpu_temperature_mean", "sample_loss_rate", "collector_lateness_p99"]
    },
    {
      "id": "gui_active_fixed",
      "kind": "gui_active_synthetic_control",
      "driver": "glmark2",
      "arguments": ["--size", "1920x1080", "--benchmark", "build:duration=30,texture:duration=30,shading:duration=30,bump:duration=30,terrain:duration=30,refract:duration=30"],
      "seed": 104729,
      "concurrency": 1,
      "warmup_seconds": 60,
      "measurement_seconds": 180,
      "input_identity": "fixed ordered on-screen glmark2 scene list at 1920x1080 with SIA GUI visible",
      "required_endpoints": ["target_throughput", "sia_cpu_rate", "sia_rss_mean", "sia_io_read_rate", "sia_io_write_rate", "target_gpu_clock_mean", "target_gpu_power_mean", "target_gpu_temperature_mean", "sia_gpu_activity_mean", "sample_loss_rate", "collector_lateness_p99"]
    }
  ],
  "endpoint_definitions": {
    "target_throughput": {"unit": "work_units/s", "aggregation": "total completed work / 180 measured seconds", "effect": "ratio", "margin": 1.03, "limits": [0.9708737864, 1.03], "rationale": "a 3% change is the largest operationally negligible user-work rate change"},
    "sia_cpu_rate": {"unit": "cpu_ms/target_s", "aggregation": "external process-tree user+system CPU milliseconds / measured target seconds", "effect": "difference", "margin": 5.0, "limits": [-5.0, 5.0], "rationale": "5 ms per second is one half percent of one CPU core"},
    "sia_rss_mean": {"unit": "MiB", "aggregation": "time-weighted mean external process-tree RSS", "effect": "difference", "margin": 10.0, "limits": [-10.0, 10.0], "rationale": "10 MiB is the largest negligible resident-memory change for the monitoring process"},
    "sia_io_read_rate": {"unit": "MiB/s", "aggregation": "external process-tree read-byte delta / measured target seconds", "effect": "difference", "margin": 0.5, "limits": [-0.5, 0.5], "rationale": "sustained 0.5 MiB/s is the largest negligible observer read load"},
    "sia_io_write_rate": {"unit": "MiB/s", "aggregation": "external process-tree write-byte delta including export and teardown / complete arm seconds", "effect": "difference", "margin": 0.5, "limits": [-0.5, 0.5], "rationale": "sustained 0.5 MiB/s is the largest negligible observer write load"},
    "target_gpu_clock_mean": {"unit": "MHz", "aggregation": "time-weighted mean external accelerator clock samples", "effect": "difference", "margin": 50.0, "limits": [-50.0, 50.0], "rationale": "50 MHz is the smallest sustained clock shift considered practically material"},
    "target_gpu_power_mean": {"unit": "W", "aggregation": "time-weighted mean external board-power samples", "effect": "difference", "margin": 3.0, "limits": [-3.0, 3.0], "rationale": "3 W is the largest negligible sustained board-power change"},
    "target_gpu_temperature_mean": {"unit": "degC", "aggregation": "time-weighted mean external accelerator temperature samples", "effect": "difference", "margin": 2.0, "limits": [-2.0, 2.0], "rationale": "2 degrees C is the largest negligible sustained thermal change"},
    "sia_gpu_activity_mean": {"unit": "percentage_point", "aggregation": "time-weighted mean utilization of the SIA process tree", "effect": "difference", "margin": 1.0, "limits": [-1.0, 1.0], "rationale": "one utilization percentage point is the largest negligible GUI observer activity"},
    "sample_loss_rate": {"unit": "percentage_point", "aggregation": "100 * missing sequence numbers / expected sequence numbers", "effect": "difference", "margin": 0.1, "limits": [-0.1, 0.1], "absolute_gate": "each arm <= 0.1 percentage point", "rationale": "loss above one sample per thousand compromises measurement fidelity"},
    "collector_lateness_p99": {"unit": "ms", "aggregation": "empirical p99 of collector receive monotonic time minus scheduled monotonic time", "effect": "difference", "margin": 2.0, "limits": [-2.0, 2.0], "absolute_gate": "each arm p99 <= 10 ms", "rationale": "2 ms arm shift or 10 ms absolute p99 is material at the declared cadence"}
  },
